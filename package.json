{
  "name": "agentplayback",
  "version": "1.0.0",
  "description": "See what your coding agents actually did all day. Claude Code and Codex sessions on a 24h dial — grouped, timed, priced, and flagged when one is waiting on you. Local only.",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "bin": {
    "agentplayback": "bin/cli.js"
  },
  "files": [
    "bin",
    "scripts/scan-day.mjs",
    "scripts/lib",
    "scripts/providers",
    "scripts/model-prices-cache.json",
    "ui/dist",
    "!ui/dist/day*.json",
    "!ui/dist/days.json",
    "!ui/dist/lab.html",
    "!ui/dist/assets/lab-*.js"
  ],
  "scripts": {
    "build": "npm run build --workspace=agentplayback-ui",
    "start": "node bin/cli.js",
    "dev": "npm run dev --workspace=agentplayback-ui",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "ai-agents",
    "agent-observability",
    "timeline",
    "dayflow"
  ],
  "homepage": "https://dayflow.so",
  "license": "MIT"
}
